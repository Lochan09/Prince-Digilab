# ── Frontend (Vite) ────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ── Serverless API (Vercel) ───────────────────────────────────────────────────
# Used by /api/orders/admin to verify Firebase tokens. Can match VITE_FIREBASE_API_KEY.
FIREBASE_API_KEY=

# Vercel Blob — optional; orders fall back to Google Drive when not set
# Create in Vercel: Project → Storage → Blob → Connect
BLOB_READ_WRITE_TOKEN=

# Gmail SMTP — use an App Password, NOT your account password
GMAIL_USER=
GMAIL_PASS=

# Email that receives new order notifications and has admin access
OWNER_EMAIL=

# Google Drive OAuth — for uploading customer photos
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REFRESH_TOKEN=
DRIVE_PARENT_FOLDER_ID=

# Re-authorize after expiry — use either URL (both work after deploy):
# https://www.princedigilab.com/auth/setup
# https://www.princedigilab.com/api/auth/setup
OAUTH_REDIRECT_URI=https://www.princedigilab.com/auth/callback
PORT=3000
