PORT=3000

# Gmail SMTP — use an App Password, NOT your account password
# Enable 2-Step Verification, then go to: Google Account > Security > App Passwords
GMAIL_USER=4kdigitalpress@gmail.com
GMAIL_PASS=xxxx xxxx xxxx xxxx

# Email address that receives new order notifications
OWNER_EMAIL=4kdigitalpress@gmail.com

# Google Drive — service account setup (one-time):
# 1. https://console.cloud.google.com > create project "Prince Digilab"
# 2. Enable Google Drive API
# 3. IAM > Service Accounts > create one > download JSON key
# 4. Place the JSON key at:  credentials/drive-service-account.json
# 5. In your Google Drive: create folder "Prince Digilab Orders"
# 6. Share that folder with the service account email as Editor
# 7. Paste the folder ID (from its Drive URL) below
GOOGLE_SA_KEY_FILE=credentials/drive-service-account.json
DRIVE_PARENT_FOLDER_ID=your_folder_id_here
