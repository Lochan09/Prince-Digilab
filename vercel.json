{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/auth/setup", "destination": "/api/auth/setup" },
    { "source": "/auth/callback", "destination": "/api/auth/callback" },
    { "source": "/((?!api/|auth/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/orders/index.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
